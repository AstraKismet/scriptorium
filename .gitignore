# pipeline state — regenerable from sources, except the translation memory
# state.db carries its -wal and -shm sidecars, which is why this is a glob: a
# committed WAL file is a half-written transaction someone else has to recover.
.lx/state.db*
.lx/docs/
.lx/reports/
# keep .lx/tm.*.jsonl: the memory is the asset, and it belongs in history
!.lx/tm.*.jsonl

# rendered output — regenerate with `lx render`; track it only if you publish from the repo
# i18n/

__pycache__/
*.py[cod]
.venv/
venv/
build/
# Anchored. A bare `dist/` matches at ANY depth, so a frontend build directory
# nested anywhere under the tree would be ignored silently — including one whose
# output is meant to be committed. This entry is for the sdist and wheel that
# `python -m build` writes at the repository root, and that is all it should ever
# catch.
/dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage

# frontend dependencies. Not ignored before 2026-08-14, which mattered more than
# it looks: `docs/conventions/delegated-work.md` §2a requires the shared checkout
# to be committed-clean before any writing worker is dispatched, and the first
# `npm install` in `studio/web/` would have made that impossible to satisfy. The
# *build output* is deliberately NOT here — it is committed into
# `src/scriptorium/web/static/`, so that `lx web` works from a bare checkout with
# no Node installed, which is invariant 1's four protected situations.
node_modules/

.mypy_cache/
coverage.xml
htmlcov/

.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# handoff work packages: a queue is working state, not history. The norm itself
# is tracked — docs/conventions/handoff-workflow.md — precisely because this
# directory is not. Never put the norm in here.
handoff/

# knowledge graph output — a local analysis artifact, and the one ignored
# directory here whose contents are NOT free to rebuild. It holds already-paid
# extraction results that no two runs reproduce: measured 2026-08-03, two runs of
# the identical corpus and prompt two days apart produced 86.6% and 4.1% coverage
# of the explanatory layer, the second costing 25% more. Rebuilding is not
# restoring. Copy it out of the working tree before deleting it.
graphify-out/

# the scan-scope file beside it: per-machine, for the same reason the graph is.
# Which paths a local analysis tool reads is a property of this checkout, not of
# the project, and 2026-07-28 settled that a tracked file may not name a tool.
.graphifyignore

# decision boards are a transient carrier; the decision's home is docs/
decision-board*.html

# background reading gathered to answer one question — landscape surveys, tool
# comparisons, vendor documentation. Same rule as a decision board: the survey is
# a carrier, and whatever it settles belongs in docs/ or in the README. Untracked
# because it goes stale the moment someone else ships a release, and a stale
# comparison in history reads as a claim.
research/

# machine-specific notes that should never reach anyone else's checkout
*.local.md

# per-machine agent tooling config (memoryRoot is an absolute local path)
.claude/dev-rituals.config.json
.claude/settings.local.json
.claude/orchestration.md

# git worktrees an assistant creates to isolate a writing agent. Transient and
# machine-local; without this every file in every worktree shows up untracked in
# the main checkout, which is how a stale worktree hides among the live ones.
# Listed per-entry rather than ignoring `.claude/` wholesale, so that a shared
# `.claude/settings.json` can still be tracked if this project ever wants one.
.claude/worktrees/

# never commit credentials; providers read keys from the environment only
.env
.env.*
*.local.json
